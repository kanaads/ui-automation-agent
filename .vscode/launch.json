{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run target app (Meridian Core demo)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["cua.target_app.app:create_app", "--factory", "--reload", "--port", "8000"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug current test file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug unit tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/unit", "-m", "unit", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug integration tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/integration", "-m", "integration", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
