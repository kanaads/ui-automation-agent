# Copy to .env and fill in only what you need.
# Nothing here is required to run unit or integration tests (those never call a real LLM).

# --- LLM provider selection (used only for `make evidence-run` / e2e_live tests) ---
# One of: groq | bedrock | nvidia_nim
LLM_PROVIDER=groq

# Groq (https://console.groq.com) — free tier, recommended default for the live discovery run
GROQ_API_KEY=

# AWS Bedrock (alternative)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# NVIDIA NIM (alternative)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# --- Target app ---
TARGET_APP_BASE_URL=http://localhost:8000
